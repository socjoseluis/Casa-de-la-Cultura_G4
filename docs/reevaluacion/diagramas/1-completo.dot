digraph "completo" {
  graph [rankdir=LR, bgcolor="white", nodesep=0.6, ranksep=1.1, pad=0.3,
         fontname="Helvetica", fontsize=16, fontcolor="#2c2825"];
  node [shape=plain, fontname="Helvetica", fontsize=12, fontcolor="#2c2825"];
  edge [arrowhead=none, color="#6e6459", penwidth=1.3, fontname="Helvetica", fontsize=11,
        fontcolor="#2c2825", labelfontsize=12, labelfontcolor="#2c2825", labeldistance=1.6];
  label="Base de datos completa (PostgreSQL)"; labelloc=t;
  "Book" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Book</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>book_id<FONT COLOR="#6e6459">: integer (único)</FONT><BR/>title<FONT COLOR="#6e6459">: varchar</FONT><BR/>original_title<FONT COLOR="#6e6459">: varchar ?</FONT><BR/>isbn<FONT COLOR="#6e6459">: varchar ?</FONT><BR/>publication_year<FONT COLOR="#6e6459">: integer ?</FONT><BR/>language_code<FONT COLOR="#6e6459">: varchar ?</FONT><BR/>image_url<FONT COLOR="#6e6459">: varchar ?</FONT></TD></TR></TABLE>>];
  "Author" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Author</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>name<FONT COLOR="#6e6459">: varchar</FONT></TD></TR></TABLE>>];
  "Genre" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Genre</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>name<FONT COLOR="#6e6459">: varchar (único)</FONT></TD></TR></TABLE>>];
  "Book_authors" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Book_authors</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>book_id<FONT COLOR="#6e6459">: bigint (FK)</FONT><BR/>author_id<FONT COLOR="#6e6459">: bigint (FK)</FONT></TD></TR></TABLE>>];
  "Book_genres" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Book_genres</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>book_id<FONT COLOR="#6e6459">: bigint (FK)</FONT><BR/>genre_id<FONT COLOR="#6e6459">: bigint (FK)</FONT></TD></TR></TABLE>>];
  "Copy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Copy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>copy_id<FONT COLOR="#6e6459">: integer (único)</FONT><BR/>book_id<FONT COLOR="#6e6459">: bigint (FK)</FONT><BR/>available<FONT COLOR="#6e6459">: boolean</FONT></TD></TR></TABLE>>];
  "LibraryUser" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e8f3e9"><B>LibraryUser</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>user_id<FONT COLOR="#6e6459">: integer (único)</FONT><BR/>birth_date<FONT COLOR="#6e6459">: date ?</FONT><BR/>comment<FONT COLOR="#6e6459">: text ?</FONT></TD></TR></TABLE>>];
  "Rating" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e8f3e9"><B>Rating</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>user_id<FONT COLOR="#6e6459">: bigint (FK)</FONT><BR/>copy_id<FONT COLOR="#6e6459">: bigint (FK)</FONT><BR/>rating<FONT COLOR="#6e6459">: integer (1-5)</FONT><BR/>created_at<FONT COLOR="#6e6459">: timestamptz</FONT></TD></TR></TABLE>>];
  "AprioriRun" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#f7e7e9"><B>AprioriRun</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>started_at<FONT COLOR="#6e6459">: timestamptz</FONT><BR/>finished_at<FONT COLOR="#6e6459">: timestamptz ?</FONT><BR/>min_rating<FONT COLOR="#6e6459">: integer</FONT><BR/>min_support<FONT COLOR="#6e6459">: float</FONT><BR/>min_confidence<FONT COLOR="#6e6459">: float</FONT><BR/>min_lift<FONT COLOR="#6e6459">: float</FONT><BR/>max_len<FONT COLOR="#6e6459">: integer</FONT><BR/>is_active<FONT COLOR="#6e6459">: boolean</FONT><BR/>transactions_count<FONT COLOR="#6e6459">: integer ?</FONT><BR/>rules_count<FONT COLOR="#6e6459">: integer ?</FONT><BR/>books_with_rules_count<FONT COLOR="#6e6459">: integer ?</FONT><BR/>covered_users_count<FONT COLOR="#6e6459">: integer ?</FONT></TD></TR></TABLE>>];
  "AssociationRule" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#f7e7e9"><B>AssociationRule</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>run_id<FONT COLOR="#6e6459">: bigint (FK)</FONT><BR/>source_book_id<FONT COLOR="#6e6459">: bigint (FK)</FONT><BR/>support<FONT COLOR="#6e6459">: float</FONT><BR/>confidence<FONT COLOR="#6e6459">: float</FONT><BR/>lift<FONT COLOR="#6e6459">: float</FONT><BR/>created_at<FONT COLOR="#6e6459">: timestamptz</FONT></TD></TR></TABLE>>];
  "AssociationRuleTarget" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#f7e7e9"><B>AssociationRuleTarget</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>id</U><FONT COLOR="#6e6459">: bigint</FONT><BR/>rule_id<FONT COLOR="#6e6459">: bigint (FK)</FONT><BR/>book_id<FONT COLOR="#6e6459">: bigint (FK)</FONT></TD></TR></TABLE>>];
  "Book_authors" -> "Book" [taillabel="*", headlabel="1"];
  "Book_authors" -> "Author" [taillabel="*", headlabel="1"];
  "Book_genres" -> "Book" [taillabel="*", headlabel="1"];
  "Book_genres" -> "Genre" [taillabel="*", headlabel="1"];
  "Copy" -> "Book" [taillabel="1..*", headlabel="1"];
  "Rating" -> "LibraryUser" [taillabel="*", headlabel="1"];
  "Rating" -> "Copy" [taillabel="*", headlabel="1"];
  "AssociationRule" -> "AprioriRun" [taillabel="*", headlabel="1"];
  "AssociationRule" -> "Book" [taillabel="*", headlabel="1"];
  "AssociationRuleTarget" -> "AssociationRule" [taillabel="1..2", headlabel="1"];
  "AssociationRuleTarget" -> "Book" [taillabel="*", headlabel="1"];
  leyenda [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4"><TR><TD BGCOLOR="#e7eef8" WIDTH="18"></TD><TD ALIGN="LEFT">Catálogo</TD></TR><TR><TD BGCOLOR="#e8f3e9" WIDTH="18"></TD><TD ALIGN="LEFT">Lectores y valoraciones</TD></TR><TR><TD BGCOLOR="#f7e7e9" WIDTH="18"></TD><TD ALIGN="LEFT">Recomendador (Apriori)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#6e6459"><U>subrayado</U> = clave primaria</FONT></TD></TR></TABLE>>];
}
