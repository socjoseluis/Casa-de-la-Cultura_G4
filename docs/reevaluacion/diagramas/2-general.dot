digraph "general" {
  graph [rankdir=LR, bgcolor="white", nodesep=0.6, ranksep=1.2, pad=0.3,
         fontname="Helvetica", fontsize=16, fontcolor="#2c2825"];
  node [shape=plain, fontname="Helvetica", fontsize=12, fontcolor="#2c2825"];
  edge [arrowhead=none, color="#6e6459", penwidth=1.3, fontname="Helvetica", fontsize=11,
        fontcolor="#2c2825", labelfontsize=12, labelfontcolor="#2c2825", labeldistance=1.6];
  label="Modelo conceptual"; labelloc=t;
  "Book" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Book</B></TD></TR></TABLE>>];
  "Author" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Author</B></TD></TR></TABLE>>];
  "Genre" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Genre</B></TD></TR></TABLE>>];
  "Copy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e7eef8"><B>Copy</B></TD></TR></TABLE>>];
  "LibraryUser" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e8f3e9"><B>LibraryUser</B></TD></TR></TABLE>>];
  "Rating" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#e8f3e9"><B>Rating</B></TD></TR></TABLE>>];
  "AprioriRun" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#f7e7e9"><B>AprioriRun</B></TD></TR></TABLE>>];
  "AssociationRule" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#6e6459"><TR><TD BGCOLOR="#f7e7e9"><B>AssociationRule</B></TD></TR></TABLE>>];
  "Book" -> "Author" [taillabel="*", headlabel="1..*", label="escrito por"];
  "Book" -> "Genre" [taillabel="*", headlabel="1..3", label="clasificado en"];
  "Book" -> "Copy" [taillabel="1", headlabel="1..*", label="tiene"];
  "AprioriRun" -> "AssociationRule" [taillabel="1", headlabel="*", label="genera"];
  "AssociationRule" -> "Book" [taillabel="*", headlabel="1", label="antecedente"];
  "AssociationRule" -> "Book" [taillabel="*", headlabel="1..2", label="consecuente"];
  ratingpunto [shape=point, width=0.05, color="#6e6459"];
  "LibraryUser" -> ratingpunto [taillabel="*"];
  ratingpunto -> "Copy" [headlabel="*", label="valora"];
  ratingpunto -> "Rating" [style=dashed];
  leyenda [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4"><TR><TD BGCOLOR="#e7eef8" WIDTH="18"></TD><TD ALIGN="LEFT">Catálogo</TD></TR><TR><TD BGCOLOR="#e8f3e9" WIDTH="18"></TD><TD ALIGN="LEFT">Lectores y valoraciones</TD></TR><TR><TD BGCOLOR="#f7e7e9" WIDTH="18"></TD><TD ALIGN="LEFT">Recomendador (Apriori)</TD></TR></TABLE>>];
}
